{
  "name": "@aios-inc/cashier-express",
  "version": "0.0.0-development",
  "description": "Express middleware and error handler for Cashier: unified subscription billing with typed req.cashier and HTTP error responses.",
  "license": "MIT",
  "author": "AIOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aios-inc/cashier.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/aios-inc/cashier#readme",
  "bugs": {
    "url": "https://github.com/aios-inc/cashier/issues"
  },
  "keywords": [
    "express",
    "expressjs",
    "middleware",
    "billing",
    "payments",
    "subscriptions",
    "stripe",
    "recurly",
    "typescript",
    "nodejs"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && cp ../../LICENSE ../../CHANGELOG.md ."
  },
  "peerDependencies": {
    "@aios-inc/cashier": "0.0.0-development",
    "express": "^4.17.0 || ^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
